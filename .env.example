# ========================================
# Yumi - 环境变量配置示例
# 将此文件复制为 .env 并根据需要修改
# ========================================

# ========================================
# 前端 (Vite) — 复制到项目根目录 .env / .env.local
# ========================================

# 设为 true 时聊天使用 SSE 流式接口（默认 false 为同步 POST /chat）
# VITE_CHAT_USE_STREAM=false

# ========================================
# 【推荐修改】常用配置
# ========================================

# ========================================
# 应用配置 (AppConfig)
# ========================================

# Debug 模式 (true/false)
YUMI_APP_DEBUG=false

# ========================================
# 服务器配置 (ServerConfig)
# ========================================

# 服务器监听地址
YUMI_SERVER_HOST=127.0.0.1

# 服务器监听端口
YUMI_SERVER_PORT=8000

# CORS 允许的源（多个用逗号分隔）
YUMI_SERVER_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost

# ========================================
# LLM 配置 (LLMConfig)
# ========================================

# LLM API 端点
YUMI_LLM_API_ENDPOINT=http://127.0.0.1:11434/v1

# LLM API 密钥
YUMI_LLM_API_KEY=

# 默认模型名称
YUMI_LLM_MODEL_NAME=llama3.1:8b

# 最大 Token 数
YUMI_LLM_MAX_TOKENS=4096

# 默认温度
YUMI_LLM_DEFAULT_TEMPERATURE=0.85

# ========================================
# 记忆引擎配置 (MemoryConfig)
# ========================================

# 检索返回数量 (RAG top-k)
YUMI_MEMORY_RAG_TOP_K=6

# 近期记忆数量
YUMI_MEMORY_RECENT_CONTEXT_LIMIT=20

# 去重相似度阈值
YUMI_MEMORY_DEDUPLICATION_THRESHOLD=0.85

# 记忆巩固提升比例
YUMI_MEMORY_CONSOLIDATION_BOOST=0.1

# ========================================
# 情绪引擎配置 (EmotionConfig)
# ========================================

# 是否启用用户情绪分析
YUMI_EMOTION_DETECTION_ENABLED=true

# 情绪分析模型 (keyword 或 transformer)
YUMI_EMOTION_MODEL=keyword

# 是否启用 AI 情绪系统
YUMI_EMOTION_AI_EMOTION_ENABLED=true

# 共情强度 (0.0-1.0)
YUMI_EMOTION_EMPATHY_FACTOR=0.3

# ========================================
# 日志配置 (LoggingConfig)
# ========================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
YUMI_LOG_LEVEL=INFO

# ========================================
# 【不建议修改】内部配置
# 修改以下配置可能会导致系统不稳定
# ========================================

# ========================================
# 应用配置 (AppConfig) - 不建议修改
# ========================================

# 应用名称
YUMI_APP_NAME=Yumi

# 应用版本
YUMI_APP_VERSION=1.0.0

# ========================================
# 数据库配置 (DatabaseConfig) - 不建议修改
# ========================================

# 数据库类型
YUMI_DB_TYPE=sqlite

# 数据库路径
YUMI_DB_PATH=data/yumi.db

# 日志数据库路径
YUMI_DB_LOG_PATH=data/yumi_logs.db

# ========================================
# 向量数据库配置 (VectorDBConfig) - 不建议修改
# ========================================

# 向量数据库类型
YUMI_VECTOR_TYPE=chromadb

# ChromaDB 持久化目录
YUMI_VECTOR_PERSIST_DIR=data/chroma

# 集合名称
YUMI_VECTOR_COLLECTION_NAME=echo_memory

# ========================================
# LLM 配置 (LLMConfig) - 不建议修改
# ========================================

# 超时时间（秒）
YUMI_LLM_TIMEOUT=60

# ========================================
# 记忆引擎配置 (MemoryConfig) - 不建议修改
# ========================================

# 摘要触发轮数
YUMI_MEMORY_SUMMARY_TRIGGER_TURNS=70

# 摘要输入记忆数
YUMI_MEMORY_SUMMARY_CONTEXT_SIZE=35

# （保留用于兼容）
YUMI_MEMORY_DECAY_RATE=0.03

# 最小衰减因子
YUMI_MEMORY_MIN_DECAY_FACTOR=0.1

# ========================================
# 情绪引擎配置 (EmotionConfig) - 不建议修改
# ========================================

# AI 情绪半衰期（秒）
YUMI_EMOTION_EMOTION_HALF_LIFE=1800

# 默认基准效价
YUMI_EMOTION_DEFAULT_BASE_VALENCE=0.3

# 默认基准唤醒度
YUMI_EMOTION_DEFAULT_BASE_AROUSAL=0.4

# 默认情绪敏感度
YUMI_EMOTION_DEFAULT_SENSITIVITY=0.7

# ========================================
# 日志配置 (LoggingConfig) - 不建议修改
# ========================================

# 日志格式
YUMI_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 日志目录
YUMI_LOG_DIR=logs

# 是否启用文件日志
YUMI_LOG_ENABLE_FILE=true

# 是否启用 JSON 格式日志
YUMI_LOG_ENABLE_JSON=false

# 单文件最大大小 (MB)
YUMI_LOG_MAX_FILE_SIZE_MB=10

# 保留文件备份数
YUMI_LOG_BACKUP_COUNT=5

# 日志保留天数
YUMI_LOG_RETENTION_DAYS=30
